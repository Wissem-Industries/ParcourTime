{
  "name": "@wissem-industries/parcourtime",
  "description": "Independent Parcoursup calendar for application phases and deadlines.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun --bun nuxt build",
    "dev": "bun --bun nuxt dev",
    "lint": "biome check .",
    "images:og": "bun scripts/og.ts",
    "start": "bun .output/server/index.mjs",
    "test": "vitest run",
    "typecheck": "node ./node_modules/nuxt/bin/nuxt.mjs typecheck --checker=golar",
    "generate": "nuxt generate",
    "preview": "bun --bun nuxt preview",
    "postinstall": "bun --bun nuxt prepare",
    "lint:fix": "biome check --write .",
    "check": "bun run lint && bun run test && bun run typecheck && bun run build",
    "release": "bun scripts/release.mjs"
  },
  "dependencies": {
    "@gouvfr/dsfr": "1.15.3",
    "@gouvminint/vue-dsfr": "8.20.0",
    "@nuxtjs/plausible": "2.0.1",
    "nuxt": "4.5.2",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@golar/vue": "0.1.10",
    "@nuxt/test-utils": "4.3.2",
    "@playwright/test": "^1.63.0",
    "@types/bun": "latest",
    "@types/node": "^26.6.3",
    "golar": "0.1.10",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "version": "1.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wissem-Industries/parcourtime.git"
  },
  "packageManager": "bun@1.4.2"
}
